{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@better-openclaw/web#build": {
      "dependsOn": ["^build", "@better-openclaw/core#build"],
      "outputs": [".next/**"]
    },
    "@better-openclaw/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@better-openclaw/core#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "create-better-openclaw#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
